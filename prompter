  shown+=(want-shown)*Math.min(1,dt*4);
  const i=Math.min(W.length-1,Math.floor(shown));
  if(W[i]){const ty=W[i].el.offsetTop-lineY()+size*0.1;y+=(ty-y)*Math.min(1,dt*5);clamp();render();paint()}
}
async function startVoice(){
  if(listening)return;listening=true;following=true;micState("wait",L.connecting);
  try{
    micStream=micStream||await navigator.mediaDevices.getUserMedia({audio:{channelCount:1,echoCancellation:false,noiseSuppression:true,autoGainControl:true}});
    if(!ctx){
      ctx=new AudioContext({sampleRate:16000});
      // ScriptProcessor: an AudioWorklet module cannot be loaded from a file:// page
      const node=ctx.createScriptProcessor(4096,1,1),sink=ctx.createGain();sink.gain.value=0;
      ctx.createMediaStreamSource(micStream).connect(node);node.connect(sink);sink.connect(ctx.destination);
      node.onaudioprocess=e=>{if(!(ws&&ready&&following&&ws.readyState===1))return;
        const c=e.inputBuffer.getChannelData(0),b=new Int16Array(c.length);
        for(let k=0;k<c.length;k++){const v=Math.max(-1,Math.min(1,c[k]));b[k]=v<0?v*32768:v*32767}ws.send(b.buffer)};
      window._promptNode=node;
    }
    await ctx.resume();resync();connect();
  }catch(err){listening=following=false;micState("err",L.micerr+" ("+err.name+")");console.log("prompter mic",err)}
}
function connect(){
  clearTimeout(retryT);ready=false;
  let worked=false,sock=null;const url=STT[sttI];
  const fail=()=>{if(sock&&ws!==sock)return;ws=null;ready=false;if(!listening)return;
    // a server that never got to session.created counts as a failed try: the first one (usually local) may still be
    // loading its model, so it gets ~10 s before the next one. After a working session drops, retry the same one.
    if(!worked){tries++;if(tries>=(sttI===0?6:2)){sttI=(sttI+1)%STT.length;tries=0}}else tries=0;
    micState(worked?"err":"wait",worked?L.lost:L.connecting);retryT=setTimeout(connect,worked?500:1700)};
  try{sock=ws=new WebSocket(url)}catch(e){fail();return}
  ws.binaryType="arraybuffer";
  ws.onmessage=e=>{if(ws!==sock||typeof e.data!=="string")return;let m;try{m=JSON.parse(e.data)}catch(x){return}
    const t=m.type||"";
    if(t==="session.created"){ws.send(JSON.stringify({type:"session.update",session:STT_LANG?{sample_rate:16000,language:STT_LANG}:{sample_rate:16000}}));ready=true;worked=true;
      tries=0;micState(following?"on":"idle",(following?L.listening:L.paused)+" · "+where())}
    else if(t.endsWith(".delta"))onDelta(m.delta||"");
    else if(t==="error")console.log("prompter stt",e.data)};
  ws.onclose=fail;
}
function stopVoice(){listening=following=false;clearTimeout(retryT);if(ws){const w=ws;ws=null;w.close()}
  if(micStream){micStream.getTracks().forEach(t=>t.stop());micStream=null}if(ctx){ctx.close();ctx=null}}
function setVoice(on){
  voice=on&&STT.length>0;store.set("voice",voice);playing=false;
  if(counting){clearInterval(counting);counting=null;count.style.display="none"}
  if(voice){micState("idle",L.voice+" · Space");resync()}else{stopVoice();mic.style.display="none";
    for(const w of W)w.el.classList.remove("past");painted=0}
  showHud(true)}
root.setProperty("--size",size+"px");document.body.classList.toggle("narrow",NARROW0||store.get("narrow",false));
document.fonts.ready.then(()=>{y=startY();render();if(STT.length&&store.get("voice",true))setVoice(true);showHud(true);requestAnimationFrame(tick);
  if(location.hash==="#autovoice"&&voice){startVoice();setInterval(()=>console.log("PROMPTER",(performance.now()/1000).toFixed(1),pos,W[pos-1]&&W[pos-1].n,"|",heard.slice(-4).join(" "),"|",mic.textContent),1000)}});
</script></body></html>
"""


def build_html(blocks: list, title: str, key: str, lang: str, wpm: int | None, narrow: bool = False,
               stt: list | None = None, stt_lang: str = "") -> str:
    t = T[lang]
    parts = []
    for b in blocks:
        if b["type"] == "break":
            parts.append('<div class="brk">•&nbsp;•&nbsp;•</div>')
        else:
            parts.append("<p>" + "".join(f'<span class="s">{html.escape(s, quote=False)}</span>'
                                         for s in b["s"]) + "</p>")
    strings = {k: t[k] for k in ("wpm", "left", "paused", "voice", "listening", "connecting", "lost", "micerr", "timed")}
    return (PAGE.replace("__LANG__", lang)
                .replace("__TITLE__", html.escape(title))
                .replace("__HELP__", t["help"])
                .replace("__END__", html.escape(t["end"]))
                .replace("__STRINGS__", json.dumps(strings, ensure_ascii=False))
                .replace("__KEYJSON__", json.dumps(key))
                .replace("__WPM__", json.dumps(wpm or 0))
                .replace("__NARROW__", json.dumps(narrow))
                .replace("__STT__", json.dumps(stt or []))
                .replace("__STTLANG__", json.dumps(stt_lang))
                .replace("__BODY__", "\n".join(parts)))


# ---------------------------------------------------------------- finding the screen

def monitors_mutter() -> list[dict]:
    """Monitors and their logical position on GNOME (X11 or Wayland)."""
    try:
        from gi.repository import Gio
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        state = bus.call_sync("org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig",
                              "org.gnome.Mutter.DisplayConfig", "GetCurrentState",
                              None, None, 0, 5000, None).unpack()
    except Exception:
        return []
    mons = {}
    for (conn, _vendor, product, _serial), modes, *_ in state[1]:
        cur = next((md for md in modes if md[6].get("is-current")), None)
        mons[conn] = {"conn": conn, "product": product, "w": cur[1] if cur else 0, "h": cur[2] if cur else 0}
    res = []
    for x, y, scale, _t, primary, outs, *_ in state[2]:
        info = dict(mons.get(outs[0][0], {"conn": outs[0][0], "product": "", "w": 0, "h": 0}))
        info.update(x=x, y=y, primary=bool(primary))
        res.append(info)
    return res


def monitors_xrandr() -> list[dict]:
    """Fallback for other X11 desktops."""
    if not shutil.which("xrandr"):
        return []
    try:
        out = subprocess.run(["xrandr", "--query"], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return []
    res = []
    for m in re.finditer(r"^(\S+) connected (primary )?(\d+)x(\d+)\+(-?\d+)\+(-?\d+)", out, re.M):
        res.append({"conn": m.group(1), "product": "", "w": int(m.group(3)), "h": int(m.group(4)),
                    "x": int(m.group(5)), "y": int(m.group(6)), "primary": bool(m.group(2))})
    return res


def is_internal(conn: str) -> bool:
    return conn.split("-")[0].upper() in ("EDP", "LVDS", "DSI")


def pick(mons: list[dict], want: str | None) -> dict | None:
    if want:
        w = want.lower()
        return next((m for m in mons if w in (m["conn"].lower(), m["product"].lower())), None)
    ext = [m for m in mons if not is_internal(m["conn"])]
    if ext:
        return next((m for m in ext if not m.get("primary")), ext[0])
    return None


def find_browser(explicit: str | None) -> str | None:
    for name in [explicit or os.environ.get("PROMPTER_BROWSER")] + BROWSERS:
        if name and shutil.which(name):
            return shutil.which(name)
    return None


# ---------------------------------------------------------------- main

def main():
    argv = sys.argv[1:]
    extra = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(prog="prompter", description=__doc__.split("\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog="\n".join(__doc__.split("\n")[2:]))
    ap.add_argument("script", help="Markdown or plain text file")
    ap.add_argument("--screen", help="connector or model of the monitor (default: the external one)")
    ap.add_argument("--wpm", type=int, help="starting speed in words per minute (default: last used, else 150)")
    ap.add_argument("--narrow", action="store_true", help="narrow column (3-4 words a line), reading line near the top, for the camera above the screen")
    cfg = load_config()
    ap.add_argument("--stt", default=os.environ.get("PROMPTER_STT", ""),
                    help="streaming transcription WebSocket(s), comma separated, tried in order (OpenAI realtime "
                         "style): the text follows your voice, V toggles. Default: \"stt\" in " + str(CONFIG))
    ap.add_argument("--no-stt", action="store_true", help="timed scroll only, even if a transcription server is set")
    ap.add_argument("--stt-lang", default=os.environ.get("PROMPTER_STT_LANG", cfg.get("stt_lang", "")),
                    help="language of the script for the transcription (e.g. fr-FR; default: detected)")
    ap.add_argument("--text", action="store_true", help="also write the cleaned script next to the file")
    ap.add_argument("--no-open", action="store_true", help="only build the page")
    ap.add_argument("--browser", help="browser command (default: Brave, Chromium, Chrome or Edge)")
    ap.add_argument("--lang", choices=sorted(T), default=os.environ.get("PROMPTER_LANG", "en"))
    a = ap.parse_args(argv)
    t = T[a.lang]
    stt = [] if a.no_stt else ([u.strip() for u in a.stt.split(",") if u.strip()] if a.stt else
                               ([cfg["stt"]] if isinstance(cfg.get("stt"), str) else list(cfg.get("stt") or [])))

    src = Path(a.script).expanduser().resolve()
    blocks = parse(src.read_text(encoding="utf-8"))
    if not blocks:
        sys.exit(t["empty"].format(path=src))
    words = count_words(blocks)
    wpm = a.wpm or 150

    DATA.mkdir(parents=True, exist_ok=True)
    page = DATA / (re.sub(r"[^\w.-]+", "-", src.stem).strip("-") + ".html")
    page.write_text(build_html(blocks, src.stem, str(src), a.lang, a.wpm, a.narrow, stt, a.stt_lang), encoding="utf-8")
    print(t["page"].format(page=page, words=words, mins=words / wpm, wpm=wpm))
    if a.text:
        out = src.with_name(src.stem + ".prompter.txt")
        out.write_text(as_text(blocks), encoding="utf-8")
        print(t["text"].format(path=out))
    if a.no_open:
        return

    browser = find_browser(a.browser)
    if not browser:
        sys.exit(t["nobrowser"])
    mons = monitors_mutter() or monitors_xrandr()
    names = ", ".join(f"{m['conn']} {m['product']}".strip() for m in mons) or t["none"]
    mon = pick(mons, a.screen)
    if not mon:
        if a.screen:
            sys.exit(t["noscreen"].format(want=a.screen, names=names))
        print(t["noext"].format(names=names))
        mon = next((m for m in mons if m.get("primary")), mons[0] if mons else
                   {"x": 0, "y": 0, "w": 0, "h": 0, "conn": "", "product": ""})
    cmd = [browser]
    if os.environ.get("XDG_SESSION_TYPE") == "wayland":
        cmd.append("--ozone-platform=x11")  # Wayland ignores --window-position, Xwayland honours it
    cmd += [f"--user-data-dir={DATA / 'browser-profile'}", "--no-first-run", "--no-default-browser-check",
            "--disable-features=Translate", f"--window-position={mon['x'] + 40},{mon['y'] + 40}",
            "--window-size=1000,700", "--start-fullscreen", f"--app={page.as_uri()}", *extra]
    server = cfg.get("stt_server")
    if stt:
        cmd.insert(1, "--use-fake-ui-for-media-stream")  # dedicated profile: grant the mic without a prompt
    if stt and server and not a.stt and not port_open(stt[0]):
        # local transcription server for the session: started with the window, stopped when it closes
        log = DATA / "stt-server.log"
        # the browser command returns at once when a prompter window is already open (same profile): the server
        # then lives while the process named in the profile's SingletonLock is alive (a crash leaves the link behind)
        lock = DATA / "browser-profile" / "SingletonLock"
        cmd = ["sh", "-c", 'log="$1" lock="$2" srv="$3"; shift 3; setsid sh -c "$srv" >>"$log" 2>&1 & s=$!; "$@"; '
               'sleep 3; while t=$(readlink "$lock") && kill -0 "${t##*-}" 2>/dev/null; do sleep 3; done; '
               'kill -- -$s 2>/dev/null; sleep 5; kill -9 -- -$s 2>/dev/null', "prompter-stt", str(log), str(lock),
               " ".join(shlex.quote(x) for x in server) if isinstance(server, list) else server, *cmd]
        print(t["stt"].format(log=log))
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    print(t["opened"].format(**mon))


if __name__ == "__main__":
    main()
