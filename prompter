def load_config() -> dict:
    """Optional ~/.config/prompter/config.json: {"stt": [urls], "stt_lang": "fr-FR", "stt_server": [argv]}."""
    try:
        cfg = json.loads(CONFIG.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        print(f"prompter: {CONFIG} ignored ({e})", file=sys.stderr)
        return {}
    if not isinstance(cfg, dict):
        print(f"prompter: {CONFIG} ignored (not a JSON object)", file=sys.stderr)
        return {}
    return cfg


def port_open(url: str) -> bool:
    import socket
    from urllib.parse import urlparse
    u = urlparse(url)
    try:
        with socket.create_connection((u.hostname, u.port or (443 if u.scheme in ("wss", "https") else 80)), timeout=0.5):
            return True
    except OSError:
        return False
