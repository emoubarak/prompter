# ---------------------------------------------------------------- cleaning the script

def strip_inline(s: str) -> str:
    s = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", s)            # images
    s = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", s)         # links -> text
    s = re.sub(r"`([^`]*)`", r"\1", s)                    # code
    s = re.sub(r"(\*\*|__)(.+?)\1", r"\2", s)              # bold
    s = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"\1", s)  # italics
    s = s.replace(" ", " ")
    return re.sub(r"\s+", " ", s).strip()


def split_sentences(p: str) -> list[str]:
    """Split after . ! ? … followed by a space and a capital, never inside « ... » or "..." quotes."""
    out, cur, depth, dquote, i = [], "", 0, False, 0
    while i < len(p):
        c = p[i]
        cur += c
        if c in "«“":
            depth += 1
        elif c in "»”":
            depth = max(0, depth - 1)
        elif c == '"':
            dquote = not dquote
        end_here = False
        if depth == 0 and not dquote and i + 1 < len(p) and p[i + 1] == " ":
            if c in ".!?…":
                end_here = True
            elif c in "»”\"" and re.search(r"[.!?…]\s*[»”\"]$", cur):
                end_here = True
        if end_here:
            nxt = p[i + 2:i + 3]
            if nxt and (nxt.isupper() or nxt in "«“\"" or nxt.isdigit()):
                out.append(cur.strip())
                cur = ""
                i += 1  # skip the space
        i += 1
    if cur.strip():
        out.append(cur.strip())
    return out


RULE = re.compile(r"\s*(-{3,}|\*{3,}|_{3,})\s*")
CUE = re.compile(r"(\*\*|__)?\[[^\]]*\](\*\*|__)?:?")


def parse(md: str) -> list:
    """Return blocks: {"type": "p", "s": [sentences]} or {"type": "break"}.

    Dropped: headings, cue lines like **[Intro]**, and prep notes above a horizontal rule
    found in the first 15 lines. Headings, cues and rules become a section break.
    """
    lines = md.replace("\r\n", "\n").split("\n")
    for idx, ln in enumerate(lines[:15]):
        if RULE.fullmatch(ln):
            lines = lines[idx + 1:]
            break
    blocks, para = [], []

    def flush():
        if para:
            text = strip_inline(" ".join(para))
            if text:
                blocks.append({"type": "p", "s": split_sentences(text)})
            para.clear()

    for ln in lines:
        s = ln.strip()
        if not s:
            flush()
            continue
        if RULE.fullmatch(s) or s.startswith("#") or CUE.fullmatch(s):
            flush()
            if blocks and blocks[-1]["type"] != "break":
                blocks.append({"type": "break"})
            continue
        s = re.sub(r"^>\s*", "", s)
        s = re.sub(r"^([-*+]|\d+[.)])\s+", "", s)
        para.append(s)
    flush()
    while blocks and blocks[0]["type"] == "break":
        blocks.pop(0)
    while blocks and blocks[-1]["type"] == "break":
        blocks.pop()
    return blocks


def as_text(blocks: list) -> str:
    return "\n\n".join("\n".join(b["s"]) if b["type"] == "p" else "• • •" for b in blocks) + "\n"


def count_words(blocks: list) -> int:
    return sum(len(" ".join(b["s"]).split()) for b in blocks if b["type"] == "p")


